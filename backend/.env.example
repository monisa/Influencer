# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Hostinger VPS-hosted Postgres in production, per PRD Section 19)
DATABASE_URL="postgresql://user:password@localhost:5432/digifox_influencer"

# Long random string — used to sign auth JWTs
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

OTP_TTL_MINUTES=10

# Origin allowed to call this API (the Next.js frontend)
CORS_ORIGIN="http://localhost:3000"

# Google Cloud Console OAuth client ID (Web application). Leave unset to disable Google Login.
GOOGLE_CLIENT_ID=

# SMTP for OTP/notification emails (Hostinger Email or any SMTP provider).
# Leave unset in development — emails log to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Digifox Influencer Network <no-reply@digifoxprosolutions.com>"
